# Nur eine Erläuterung der Einstellungen. Die Installation erhält deine .env.
# Zugangsdaten aus deiner vorhandenen Datei übernehmen; diese Vorlage enthält keine.
REPORT_DIR=/volume2/docker/securitywatch/reports
CACHE_DIR=/volume2/docker/securitywatch/trivy-cache
STATE_DIR=/volume2/docker/securitywatch/state

TRIVY_IMAGE=ghcr.io/aquasecurity/trivy:latest
TRIVY_AUTO_PULL_IMAGE=1
TRIVY_TIMEOUT=60m
TRIVY_SCAN_FILESYSTEM=1
TRIVY_SCAN_IMAGES=1
TRIVY_HOST_FORCE_DISTRO=debian/12
TRIVY_HOST_SKIP_STANDARD_DIRS=1
TRIVY_PKG_TYPES=os,library
HOST_PACKAGE_INVENTORY_ENABLED=1

# Nur eindeutig zugeordnete, laufende und erfolgreich geprüfte Compose-Dienste.
LOCAL_IMAGE_AUTO_REBUILD_ENABLED=1
LOCAL_IMAGE_AUTO_REBUILD_PULL=1
LOCAL_IMAGE_AUTO_REBUILD_NO_CACHE=1
# Sechs Tage Mindestabstand ermöglichen den Neubau in jedem Wochenlauf,
# auch wenn der vorherige Lauf etwas länger dauerte. Die Aufbewahrung bleibt 7 Tage.
LOCAL_IMAGE_REBUILD_INTERVAL_HOURS=144
# Fehlgeschlagene Versuche nach einem Tag erneut zulassen. Geänderte Baugrundlagen
# oder Sicherheitsbefunde werden unabhängig von dieser Wartefrist neu geprüft.
LOCAL_IMAGE_REBUILD_RETRY_HOURS=24
LOCAL_IMAGE_AUTO_REBUILD_TARGET_PATTERNS=
LOCAL_IMAGE_INCLUDE_PATTERNS=
LOCAL_IMAGE_EXCLUDE_PATTERNS=

IMAGE_UPDATE_CHECK_ENABLED=1
IMAGE_UPDATE_AUTO_RECREATE_ENABLED=1
IMAGE_UPDATE_AUTO_RECREATE_INCLUDE_PATTERNS=
IMAGE_UPDATE_AUTO_RECREATE_EXCLUDE_PATTERNS=
UGOS_AUTO_UPDATE_EXCLUDE_PROJECTS=wazuh,ugreen_minecraft_java
IMAGE_UPDATE_VERIFY_TIMEOUT_SECONDS=120
IMAGE_UPDATE_VERIFY_MAX_SECONDS=2400
IMAGE_UPDATE_VERIFY_INTERVAL_SECONDS=5
IMAGE_UPDATE_VERIFY_STABLE_SECONDS=10
IMAGE_RETENTION_DAYS=7

REPORT_CLEANUP_ENABLED=1
REPORT_RETENTION_DAYS=30
REPORT_KEEP_LAST=10
GITHUB_CONFIG_FILE=/volume2/docker/securitywatch/securitywatch.github.json
# Für öffentliche Projekte genügt zunächst ein lesender Zugriff ohne Zugangsschlüssel.
# GITHUB_TOKEN_FILE=/volume2/docker/securitywatch/github-token

SMTP_SERVER=mail.example.org
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_SSL=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=securitywatch@example.org
SMTP_TO=admin@example.org
MAIL_SUBJECT_PREFIX='[SecurityWatch]'
MAIL_ONLY_ON_FINDINGS=1
MAIL_SEND_OK=0
MAIL_SEND_ON_IMAGE_UPDATES=1
MAIL_SEND_WEEKLY_SUMMARY=1
